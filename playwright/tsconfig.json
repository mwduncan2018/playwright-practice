{
  // Playwright compiles the tests itself; tsc only type-checks (npm run typecheck).
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "merge.config.ts", "shared/**/*.ts", "apps/**/*.ts"]
}
