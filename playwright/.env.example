# Copy this file to .env for local runs: cp .env.example .env
# .env is git-ignored and kept out of the Docker image. In a pipeline, set these as CI variables
# instead, with the passwords masked. README.md describes every variable.

# The application to test: super-catalog or super-portal
TEST_APP=super-catalog

# Each application's address. A run reads only the address of the app it's testing. These are the
# local Docker environment's; change them to test a site somewhere else.
SUPER_CATALOG_URL=http://localhost:3001
SUPER_PORTAL_URL=http://localhost:3002

# Browsers, comma-separated: chromium, firefox, webkit, chrome, msedge
TEST_BROWSER=chromium

# Passwords for the test accounts. These are the local environment's (they're in
# keycloak-realm.json); real environments' passwords never go in a file in the repo.
TEST_PASSWORD_ADMIN1=admin1-password
TEST_PASSWORD_ADMIN2=admin2-password
TEST_PASSWORD_ADMIN3=admin3-password
TEST_PASSWORD_ADMIN4=admin4-password
TEST_PASSWORD_STANDARD1=standard1-password
TEST_PASSWORD_STANDARD2=standard2-password
TEST_PASSWORD_STANDARD3=standard3-password
TEST_PASSWORD_STANDARD4=standard4-password
