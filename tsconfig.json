{
  // Playwright compiles the tests itself; tsc is only used for type checking (npm run typecheck).
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "support/**/*.ts"]
}
