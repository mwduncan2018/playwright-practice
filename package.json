{
  "name": "playwright-practice",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript practice suite for the local Research site",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --ui",
    "test:trace": "playwright test --project=chromium --trace=on",
    "test:repeat": "playwright test --project=chromium --repeat-each=10",
    "report": "playwright show-report",
    "typecheck": "tsc",
    "docker:build": "docker compose build",
    "docker:test": "docker compose up --exit-code-from tests",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
