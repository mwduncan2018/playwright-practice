TEST_APP_FOLDER=tests/super-catalog
#TEST_APP_FOLDER=tests/super-portal

TEST_APP_URL=http://localhost:3001/
#TEST_APP_URL=http://localhost:3002/

# Browser options are chromium, firefox, webkit, msedge, chrome
TEST_BROWSER=chromium

TEST_PARALLEL=true
TEST_RETRIES=0
TEST_WORKERS=2

# Trace options:
#   off                            no traces
#   on                             a trace of every run
#   retain-on-failure              a trace of every failed run
#   on-first-retry                 a trace of each test's first retry (the default)
#   on-all-retries                 a trace of every retry
#   retain-on-first-failure        a trace of a test's first run, if it failed
#   retain-on-failure-and-retries  a trace of every failed run and every retry
TEST_TRACE=retain-on-failure

TEST_HISTORY_KEEP=20

# Passwords for Super Catalog and Super Portal's test accounts. These are the local Docker
# environment's, from keycloak-realm.json; other environments' passwords never go in this file.
TEST_PASSWORD_ADMIN1=admin1-password
TEST_PASSWORD_ADMIN2=admin2-password
TEST_PASSWORD_ADMIN3=admin3-password
TEST_PASSWORD_ADMIN4=admin4-password
TEST_PASSWORD_STANDARD1=standard1-password
TEST_PASSWORD_STANDARD2=standard2-password
TEST_PASSWORD_STANDARD3=standard3-password
TEST_PASSWORD_STANDARD4=standard4-password

TEST_ADMIN_USERNAME=sampleadmin
TEST_ADMIN_PASSWORD=samplepassword